# Biblioteca Central — copie para .env e preencha
PORT=3500
HOST=127.0.0.1
# Pasta dos dados (banco + arquivos). Faça backup dela.
DATA_DIR=./dados
# Senha para entrar no painel da Biblioteca (mínimo 8 caracteres)
ADMIN_PASSWORD=
# Token de publicação: o mesmo valor vai no .env do painel matriz como BIBLIOTECA_ADMIN
# Gere um longo, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Deixe 1 quando estiver atrás do nginx com HTTPS (cookie seguro)
HTTPS=1
