# Copie para .env e preencha. Nunca compartilhe este arquivo.

# Senha de acesso ao painel (mínimo 8 caracteres — use uma frase longa)
ADMIN_PASSWORD=troque-por-uma-senha-forte

# MODO CHAT (padrão, sem API): deixe a linha abaixo comentada.
# O painel monta o pedido de cada etapa, você cola no chat com o Claude
# e cola a resposta de volta.
#
# MODO AUTOMÁTICO (opcional): para a equipe trabalhar sozinha 24h, remova o "#"
# e coloque uma chave da API (console.anthropic.com).
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5

# Rede: no teste local pode deixar assim.
# Na VPS, mantenha 127.0.0.1 e deixe o Caddy/Nginx expor o domínio com HTTPS.
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=0

# Onde ficam o banco e o segredo de sessão (faça backup desta pasta)
DATA_DIR=./data

# ─────────────── MOTOR DE VÍDEO (opcional) ───────────────
# O painel gera sozinho o MP4 dos reels (voz + objetos 3D + motion). Sem estas chaves ele
# ainda renderiza: sem narração e com emojis no lugar dos objetos 3D. Nunca cole as chaves em chats.

# Narração — ElevenLabs (painel do ElevenLabs > Developers > API Keys). A voz precisa estar em "Minhas vozes".
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Narração alternativa — Murf (só é usada se o ElevenLabs não estiver configurado, ou se você escolher em Configurações)
MURF_API_KEY=
MURF_VOICE_ID=

# Objetos 3D com fundo transparente — fal.ai (painel do fal.ai > Keys)
FAL_KEY=
FAL_GEN_MODEL=fal-ai/flux/schnell
FAL_BG_MODEL=fal-ai/birefnet/v2

# ─────────────── BANCOS DE IMAGENS (busca de fotos no editor de arte) ───────────────
# Todos grátis, uso comercial liberado. Sem nenhuma chave, só o Openverse funciona (menos opções).
# Pixabay: pixabay.com/api/docs (logado, a chave aparece na página). Boa para vetores e ilustrações.
PIXABAY_API_KEY=
# Unsplash: unsplash.com/developers > Your apps > New Application > copie o "Access Key". Fotos de alta qualidade.
UNSPLASH_ACCESS_KEY=
# Pexels: pexels.com/api (a emissão de chaves novas está pausada no momento; se você já tem uma, cole aqui).
PEXELS_API_KEY=


# Avançado (normalmente não mexer)
# VOZ_PROVIDER=elevenlabs
# ELEVEN_BASE=https://api.elevenlabs.io
# FAL_BASE=https://fal.run

# Imagens de fundo por IA (opcional). Modelo do fal.ai:
# FAL_IMG_MODEL=fal-ai/flux/schnell

# Poses do mascote (opcional):
# FAL_POSE_MODEL=fal-ai/flux-pro/kontext
# Preços de referência em US$ por imagem, só para a estimativa de custo no painel:
# FAL_PRECO_FUNDO=0.003
# FAL_PRECO_POSE=0.04
# FAL_PRECO_RECORTE=0.003

# Biblioteca Central (material oficial que atualiza sozinho)
# Endereço da Biblioteca e a chave de licença deste painel (criada na aba Clientes da Biblioteca)
BIBLIOTECA_URL=
BIBLIOTECA_CHAVE=
# Só no painel matriz: o ADMIN_TOKEN da Biblioteca, para publicar. Nunca entregue ao cliente.
BIBLIOTECA_ADMIN=

# Cortes de video (ClippyMe, dentro do Estudio de video > aba Cortes)
# Chave gratis do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
CLIPPYME_URL=http://127.0.0.1:8000
CLIPPYME_DASHBOARD_URL=http://localhost:5175
